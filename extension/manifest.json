{
  "manifest_version": 3,
  "name": "Paragloss",
  "version": "0.1.0",
  "description": "Hold Alt over the paragraph you're stuck on to see its translation above it: free in Chrome, or from the AI you choose.",
  "permissions": ["storage", "activeTab", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*",
    "https://api.mistral.ai/*",
    "https://api.x.ai/*",
    "https://*.aliyuncs.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/block.js",
        "content/selection.js",
        "content/language.js",
        "content/translator.js",
        "content/popup.js",
        "content/highlight.js",
        "content/composer.js",
        "content/compose-window.js",
        "content/pup.js",
        "content/hero.js",
        "content/main.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Paragloss: write in another language", "default_popup": "compose.html" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" } }
  }
}
